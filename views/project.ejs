    <script>
      function updateAOSDelays() {
        const cards = document.querySelectorAll('.card-container');
        const screenWidth = window.innerWidth;

        cards.forEach((card, index) => {
          if (screenWidth <= 888) {
            card.setAttribute('data-aos-delay', '0');
          } else if (screenWidth > 888 && screenWidth < 1406) {
            card.setAttribute('data-aos-delay', (index % 2 === 1) ? '100' : '0');
          } else if (screenWidth >= 1406) {
            card.setAttribute('data-aos-delay', `${(index % 3) * 100}`);
          }
        });
      }
      updateAOSDelays();
      window.addEventListener('resize', updateAOSDelays);
    </script>
    <script>
      AOS.init();
    </script>
