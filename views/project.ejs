    <!-- cards -->
    <div class="projectsGrid">
      <% for (const project of projects) { %>
      <div
        data-aos="fade-up"
        style="
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        "
        class="card-container"
      >
        <div class="card">
          <header class="card-header">
            <a class="title" href="<%= project.projectUrl %>" target="_blank"><%= project.projectName %>
              <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </div>
            </a>
            <div class="repo-stats">
              <div class="repo-stars">
                <span class="icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                </span> <%= project.stars %>
              </div>
              <div class="repo-issues">
                <span class="icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/></svg>
                </span> <%= project.open_issues %>
              </div>
              <!-- <div class="repo-forks">
                <span class="icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-fork"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>
                </span> 55
              </div> -->
            </div>

            <div class="tags">
              <% for( const topic of project.topics.slice(0, 4) ) { %>
                <span class="pill"><%= topic %></span>
              <% } %>
            </div>
          </header>

          <div class="bottom">
            <div class="languages">
              <% for(var j=0; j < project.language.length; j++) { %>
              <p class="repo-language"><%= project.language[j] %></p>
              <% }%>
            </div>
  
            <div class="desc flex items-end justify-center"><%= project.description.substring(0, 110) %><% if (project.description.length > 125) { %>...<% } %>
            </div>  
          </div>
        </div>
      </div>
      <%}%>
    </div>

    <div
      class="projFooter"
      style="text-align: center; padding: 10px; background: #00ff75"
    >
      <p class="footText">Make the contributions rain! 🌧️</p>
    </div>

